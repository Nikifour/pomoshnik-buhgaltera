.venv/
build/
dist/
__pycache__/
*.spec
*.pyc

# ДАННЫЕ КОМПАНИИ НЕ ПОПАДАЮТ В РЕПОЗИТОРИЙ:
# контакты, реквизиты, тексты, логотипы, печать и подпись живут только в data/
data/
# в assets только иконка программы — никаких логотипов и печатей
assets/*
!assets/icon.ico
# любые картинки, кроме иконки
*.png
*.jpg
*.jpeg
*.bmp
# счета и готовые КП содержат данные клиентов
*.pdf
*.xlsx
*.xls
*.doc
*.docx
# файлы переноса настроек содержат данные компании
*.pbsettings
